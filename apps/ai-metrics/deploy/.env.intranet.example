# ─── 内网部署示例 ──────────────────────────────────────────────
# 把 nexus.intra / harbor.intra 改成你公司的实际 host。
# 复制到 deploy/.env 后改值。

# 镜像走私有 Harbor / 阿里云 ACR
PYTHON_IMAGE=harbor.intra/library/python:3.12-slim
MYSQL_IMAGE=harbor.intra/library/mysql:8.0

# Debian APT 走 Nexus apt-proxy 仓库
APT_MIRROR=http://nexus.intra/repository/debian-proxy

# pip 走 Nexus 私有 PyPI 代理
PIP_INDEX_URL=https://nexus.intra/repository/pypi-public/simple/
PIP_TRUSTED_HOST=nexus.intra

# npm 走 Nexus 私有 npm 代理（本镜像无 npm，占位）
NPM_REGISTRY=https://nexus.intra/repository/npm-public/

# 应用
APP_PORT=8001
CORS_ORIGINS=*
IMAGE_TAG=v0.1.0-intra

# DB
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app


# ─── 常用公网镜像源参考（粘贴用）─────────────────────────────────
# Tsinghua (中国)
#   APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple/
#   NPM_REGISTRY=https://registry.npmmirror.com/
# Aliyun (中国)
#   APT_MIRROR=http://mirrors.aliyun.com/debian
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
#   NPM_REGISTRY=https://registry.npmmirror.com/
# USTC (中国)
#   APT_MIRROR=https://mirrors.ustc.edu.cn/debian
#   PIP_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple/
