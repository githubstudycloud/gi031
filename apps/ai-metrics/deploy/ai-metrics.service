[Unit]
Description=AI Metrics Dashboard (FastAPI)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-metrics
EnvironmentFile=/opt/ai-metrics/.env
ExecStart=/opt/ai-metrics/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
