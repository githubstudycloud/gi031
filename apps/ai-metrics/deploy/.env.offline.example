# ─── 离线 / 内网部署 ─────────────────────────────────────────────
# 复制到 deploy/.env.offline 后改值

# 已有的基础镜像（不下载）
PYTHON_IMAGE=python:3.12-slim
IMAGE_TAG=offline

# 内网 pip 源（必填 —— 容器内装 fastapi/sqlalchemy/pymysql 时用）
PIP_INDEX_URL=https://nexus.intra/repository/pypi-public/simple/
PIP_TRUSTED_HOST=nexus.intra

# 应用对外端口
APP_PORT=8001
GEN_PORT=8002
CORS_ORIGINS=*

# ─── V4 admin 鉴权 ─────────────────────────────────────────────
# 空字符串 = dev 模式不鉴权（启动 warn）；生产部署务必设置一个长字符串
# 设置后，admin UI 启动时会弹窗要 token；所有 /api/admin/* 与 ingest 都要 X-Admin-Token
ADMIN_TOKEN=

# ─── V4 服务发现（admin UI 顶栏跳转用） ───────────────────────────
# 留空时 admin UI 用 location.origin（同 host 跳 /ui /vue /react，适合单机）
# 反代场景填外网可见的 query 服务 URL，如 https://metrics.example.com
QUERY_URL=
GENERATION_URL=

# ─── 生成服务调度 (空字符串 = 关闭对应任务) ────────────────────
SIM_CRON=0 */2 * * *
PREAGG_CRON=10 */2 * * *
SIM_DAYS_BACK=1
SIM_RUNS_PER_CALL=1

# ─── 数据库 ───────────────────────────────────────────────────
# 连 host 上 mysql 5.7 (不起 db 容器)
# 启动前请在 mysql 5.7 上准备库 + 账号（见 deploy-offline.sh setup-db）：
#   CREATE DATABASE ai_metrics CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'ai_metrics'@'%' IDENTIFIED BY 'CHANGE-ME';
#   GRANT ALL ON ai_metrics.* TO 'ai_metrics'@'%';
#   FLUSH PRIVILEGES;
DATABASE_URL=mysql+pymysql://ai_metrics:CHANGE-ME@host.docker.internal:3306/ai_metrics?charset=utf8mb4

# ─── 可选：如果 host.docker.internal 在你的 docker 版本不可用，改用 host IP
# DATABASE_URL=mysql+pymysql://ai_metrics:pwd@192.168.0.132:3306/ai_metrics?charset=utf8mb4
