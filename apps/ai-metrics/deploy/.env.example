# ─── 公网 / 默认配置 ───────────────────────────────────────────
# 复制到 deploy/.env 即可。所有变量都给了合理默认，可以全部留空。

# 镜像（公网官方）
PYTHON_IMAGE=python:3.12-slim
MYSQL_IMAGE=mysql:8.0

# 包管理源
# 留空 = 使用官方源（PyPI / Debian / npm）
APT_MIRROR=
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
NPM_REGISTRY=

# 应用
APP_PORT=8001
CORS_ORIGINS=*
IMAGE_TAG=local

# DB
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=rootpwd
MYSQL_PASSWORD=aimpwd
